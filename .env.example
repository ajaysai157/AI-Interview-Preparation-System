# ============================================================
# Application Configuration
# ============================================================
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# CORS - origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# LLM Provider Configuration (Default: Local Ollama)
# ============================================================
# Supported providers: ollama (default), mock, openai, anthropic, google
LLM_PROVIDER=ollama
LLM_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Optional External API Keys (Leave empty to use local Ollama)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# ============================================================
# Interview Evaluation & Adaptive Thresholds
# ============================================================
# Composite score (0-10) below which an evaluation triggers human review
HUMAN_REVIEW_THRESHOLD=5.0

# Adaptive difficulty thresholds (composite score out of 10)
# score >= upgrade threshold  -> increase difficulty (easy -> medium -> hard)
# score <  downgrade threshold -> decrease difficulty (hard -> medium -> easy)
DIFFICULTY_UPGRADE_THRESHOLD=8.0
DIFFICULTY_DOWNGRADE_THRESHOLD=5.0